<policies>
    <inbound>
        <base />

            <return-response>
                <set-header name="Content-Type" exists-action="override">
                    <value>text/xml</value>
                </set-header>
                <set-body template="liquid">
                    <soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"  xmlns:ppt="http://ws.pagamenti.telematici.gov/">
                        <soapenv:Body>
                            <ppt:nodoChiediTemplateInformativaPSPRisposta>
                                <fault>
                                    <faultCode>PPT_SERVIZIO_NONATTIVO</faultCode>
                                    <faultString>La primitiva è deprecata</faultString>
                                    <id>NodoDeiPagamentiSPC</id>
                                    <description>Il servizio non è attivo</description>
                                </fault>
                            </ppt:nodoChiediTemplateInformativaPSPRisposta>
                        </soapenv:Body>
                    </soapenv:Envelope>

                </set-body>
            </return-response>

    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
